SECRET_KEY=replace-with-a-secure-random-value
SESSION_COOKIE_SECURE=false

# Optional locally. If omitted, StudExEl uses database/studexel.db.
# DATABASE_URL=sqlite:///database/studexel.db

# Production PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://username:password@host/database_name

# Optional upload location override.
# ITEM_IMAGE_UPLOAD_FOLDER=backend/static/uploads/items

# Image storage: local or cloudinary
ITEM_IMAGE_STORAGE=local

# Required only when ITEM_IMAGE_STORAGE=cloudinary
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Transactional email through Resend
# RESEND_API_KEY=re_your_api_key
# EMAIL_FROM=StudExEl <noreply@your-domain.com>

# Public application address used in emailed links
APP_BASE_URL=http://127.0.0.1:5000
